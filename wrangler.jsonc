{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cambio-game",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }] },
  "d1_databases": [{ "binding": "ANALYTICS", "database_name": "cambio-analytics", "database_id": "34ea35be-b58e-4131-bf23-52f6296ad72c", "migrations_dir": "migrations" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "vars": { "ALLOWED_ORIGINS": "http://127.0.0.1:3000,http://localhost:3000,https://cambio.shrysjain.me,https://cambio-rho-ten.vercel.app" },
  "observability": { "enabled": true }
}
